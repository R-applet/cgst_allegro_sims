# large or regenerable simulation outputs
*.lammpstrj
*.lammpstrj.gz
*.restart*
restart.*
*.pt2
*.ckpt
*.npy
slurm-*.out
# generated structures (rebuild with structures/build_supercells.py)
structures/111/
structures/222/
structures/333/
structures/444/
# data files under tests/: LAMMPS outputs, plus model_check/frame_*.data written by model_check.py prepare.
# Together with *.npy (reference forces), 1b inputs are not tracked; rerun `model_check.py prepare` to regenerate.
tests/**/*.data
*/runs/
# conda env
env/cgst-ana/
env/create.log
# DoSPT build tree (analysis/build_dospt.sh)
env/dospt/
# vendored skill files
skills/
# python bytecode
__pycache__/
# latent feasibility features (8.8 MB; regenerate with analysis/latent_features.py, see its README)
tests/latent_feasibility/features.npz
# reference copies of run inputs written by common/run_lmp.sh; the test inputs are tracked themselves
tests/**/lmp_inputs/
