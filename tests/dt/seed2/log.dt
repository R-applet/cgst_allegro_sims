write_data      liquid_1500.data
System init for write_data ...

variable        h index 0.0005 0.001 0.002
label           loop
clear
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
units           metal
atom_style      atomic
boundary        p p p
variable        dt equal ${h}
variable        dt equal 0.0005
read_data       liquid_1500.data
Reading data file ...
  orthogonal box = (-1.1706555 -1.1706555 -1.1706555) to (49.410656 49.410656 49.410656)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  4096 atoms
  reading velocities ...
  4096 velocities
  read_data CPU = 0.135 seconds
include         ${root}/common/in.potential
include         /scratch/gilbreth/rapplet/cgst_allegro_sims/common/in.potential
# Shared potential, neighbor and group setup for every run in this project.
# Include after read_data / read_restart. Caller must define:
#   model   path to the compiled Allegro model (models/run5_ep301.nequip.pt2)
#   dt      timestep in ps (production value: common/defaults.sh; justified by tests/RESULTS.md, 1c)
# Type order is fixed by the model: 1 Ge, 2 Sb, 3 Te, 4 C (type 4 exists even when there is no C).

newton          on

pair_style      allegro
pair_coeff      * * ${model} Ge Sb Te C     # model cutoff 6.0 A
pair_coeff      * * /scratch/gilbreth/rapplet/cgst_allegro_sims/models/run5_ep301.nequip.pt2 Ge Sb Te C     

neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 7.5                  # ghost shell >= 6.0 A RDF range + 1.0 A skin

group           Ge type 1
816 atoms in group Ge
group           Sb type 2
824 atoms in group Sb
group           Te type 3
2048 atoms in group Te
group           C  type 4
408 atoms in group C
variable        nC equal count(C)

timestep        ${dt}
timestep        0.0005
variable        nout equal round(0.1/dt)
variable        nrun equal round(${nve_ps}/dt)
variable        nrun equal round(40/dt)
fix             nve all nve
thermo_style    custom step time temp pe etotal
thermo          ${nout}
thermo          200
fix             e all print ${nout} "$(time) $(temp) $(pe/atoms:%.10f) $(etotal/atoms:%.10f)"                 file nve_dt${h}.dat screen no title "time_ps T_K PE_eV_per_atom Etot_eV_per_atom"
fix             e all print 200 "$(time) $(temp) $(pe/atoms:%.10f) $(etotal/atoms:%.10f)"                 file nve_dt${h}.dat screen no title "time_ps T_K PE_eV_per_atom Etot_eV_per_atom"
fix             e all print 200 "$(time) $(temp) $(pe/atoms:%.10f) $(etotal/atoms:%.10f)"                 file nve_dt0.0005.dat screen no title "time_ps T_K PE_eV_per_atom Etot_eV_per_atom"
run             ${nrun}
run             80000
