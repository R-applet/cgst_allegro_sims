LAMMPS (30 Mar 2026)
KOKKOS mode with Kokkos version 5.0.2 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
# Test 1c: timestep choice from NVE energy conservation in the hottest, most C-rich state we simulate.
#   2x2x2 x10 cell (4096 atoms, 408 C) -> minimize -> NPT 1500 K, 20 ps at dt = 1 fs (liquid, C mobile)
#   -> for dt in 0.5, 1, 2 fs: NVE 20 ps from that same liquid, total energy every 0.1 ps -> nve_dt<dt>.dat
# tests/dt/analyze_dt.py fits the drift. Pass: largest dt with |drift| <= 0.05 meV/atom/ps and
# std(E_tot) <= 1% of std(PE) (see tests/RESULTS.md).

units           metal
atom_style      atomic
boundary        p p p

variable        model index ../../models/run5_ep301.nequip.pt2
variable        dt    equal 0.001        # equal-style so the loop below can redefine it
read_data       ../../structures/222/x10.data
Reading data file ...
  orthogonal box = (0 0 0) to (48.24 48.24 48.24)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  4096 atoms
  read_data CPU = 0.148 seconds
include         ../../common/in.potential
# Shared potential, neighbor and group setup for every run in this project.
# Include after read_data / read_restart. Caller must define:
#   model   path to the compiled Allegro model (models/run5_ep301.nequip.pt2)
#   dt      timestep in ps (chosen by tests/dt; see tests/RESULTS.md)
# Type order is fixed by the model: 1 Ge, 2 Sb, 3 Te, 4 C (type 4 exists even when there is no C).

newton          on

pair_style      allegro
pair_coeff      * * ${model} Ge Sb Te C     # model cutoff 6.0 A
pair_coeff      * * ../../models/run5_ep301.nequip.pt2 Ge Sb Te C     

neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 7.5                  # ghost shell >= 6.0 A RDF range + 1.0 A skin

group           Ge type 1
816 atoms in group Ge
group           Sb type 2
824 atoms in group Sb
group           Te type 3
2048 atoms in group Te
group           C  type 4
408 atoms in group C
variable        nC equal count(C)

timestep        ${dt}
timestep        0.001

thermo          100
minimize        1.0e-6 1.0e-8 500 5000

