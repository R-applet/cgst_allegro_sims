LAMMPS (30 Mar 2026)
KOKKOS mode with Kokkos version 5.0.2 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
# Test 1a (smoke): the model loads with every type present, the shared includes run, and every output is written.
# Run with -var cell <x0|x10>. x0 has no C atoms (exercises the empty-C guard); x10 has the most C.
#   minimize -> NPT 600 K 2 ps (thermo every 0.1 ps) -> RDF averaged over 1 ps -> write_data
# Pass: no errors or lost atoms, finite PE, smoke_${cell}.dat has 13 columns, rdf_${cell}.dat has one non-empty block.

units           metal
atom_style      atomic
boundary        p p p

# model: required, -var model $MODEL (common/defaults.sh picks models/$MODEL_ID[.G|.N].nequip.pt2 per node)
variable        dt        index 0.001
variable        out       index smoke_${cell}
variable        out       index smoke_x0
variable        thermo_ps index 0.1

read_data       ../../structures/111/${cell}.data
read_data       ../../structures/111/x0.data
Reading data file ...
  orthogonal box = (0 0 0) to (24.12 24.12 24.12)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  461 atoms
  read_data CPU = 0.053 seconds
include         ../../common/in.potential
# Shared potential, neighbor and group setup for every run in this project.
# Include after read_data / read_restart. Caller must define:
#   model   path to the compiled Allegro model (models/$MODEL_ID[.G|.N].nequip.pt2, from common/defaults.sh)
#   dt      timestep in ps (production value: common/defaults.sh; justified by tests/RESULTS.md, 1c)
# Type order is fixed by the model: 1 Ge, 2 Sb, 3 Te, 4 C (type 4 exists even when there is no C).

newton          on

pair_style      allegro
pair_coeff      * * ${model} Ge Sb Te C     # model cutoff 6.0 A
pair_coeff      * * /scratch/gilbreth/rapplet/cgst_allegro_sims/models/nozbl_paw.G.nequip.pt2 Ge Sb Te C     

neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 7.5                  # ghost shell >= 6.0 A RDF range + 1.0 A skin

group           Ge type 1
102 atoms in group Ge
group           Sb type 2
103 atoms in group Sb
group           Te type 3
256 atoms in group Te
group           C  type 4
0 atoms in group C
group           GST type 1 2 3              # the lattice-forming species (xfracGST, common/in.analysis)
461 atoms in group GST
variable        nC equal count(C)

timestep        ${dt}
timestep        0.001

thermo          10
thermo_style    custom step pe press vol
minimize        1.0e-6 1.0e-8 200 2000

