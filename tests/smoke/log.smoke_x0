variable        rdf_ps   index 1.0
variable        rdf_file index rdf_${cell}.dat
variable        rdf_file index rdf_x0.dat
include         ../../common/in.rdf
# Time-averaged partial RDFs over the next rdf_ps of whatever integrator fix is active.
# Include at the point where averaging should start. Caller must define:
#   rdf_ps    averaging window in ps
#   rdf_file  output file
# Writes one block at the end of the window: total g(r) plus all 10 partials (Ge-Ge Ge-Sb Ge-Te Ge-C
# Sb-Sb Sb-Te Sb-C Te-Te Te-C C-C), each with its running coordination number. 300 bins to 6.0 A.
#
# fix ave/time only writes on timesteps that are multiples of Nfreq, and only when the whole sampling window
# lies after the fix was defined. The example run in md_meltquench lost its RDF for this reason. So first run
# "pad" steps up to the next multiple of Nfreq, then define the fix and run exactly one window.

variable        rdf_N   equal round(${rdf_ps}/${dt})        # window length (steps) = Nfreq
variable        rdf_N   equal round(1.0/${dt})        
variable        rdf_N   equal round(1.0/0.001)        
variable        rdf_nev equal round(0.1/${dt})              # sample every 0.1 ps
variable        rdf_nev equal round(0.1/0.001)              
variable        rdf_nrep equal ${rdf_N}/${rdf_nev}
variable        rdf_nrep equal 1000/${rdf_nev}
variable        rdf_nrep equal 1000/100
variable        rdf_pad equal ${rdf_N}*ceil(step/${rdf_N})-step
variable        rdf_pad equal 1000*ceil(step/${rdf_N})-step
variable        rdf_pad equal 1000*ceil(step/1000)-step

compute         rdf all rdf 300 * * 1 1 1 2 1 3 1 4 2 2 2 3 2 4 3 3 3 4 4 4 cutoff 6.0
run             ${rdf_pad}
run             0
