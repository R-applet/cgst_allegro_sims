# Tests 1d/1e: throughput of a production-size cell (x10; -var size 333 = 13824 atoms by default, 444 = 32768) and the
# cost of on-the-fly analysis. Run with -var ana <0|1>. NPT 600 K from the rocksalt cell: 500 warm-up steps, then a timed 3000-step run.
# ana=1 includes common/in.analysis at its production interval (thermo_ps = 1 ps) plus a trajectory dump with
# the per-atom q4 columns at 5 ps; ana=0 runs the bare potential.
# Read "Performance:" from the second run of each log.

units           metal
atom_style      atomic
boundary        p p p

# model: required, -var model $MODEL (common/defaults.sh picks models/$MODEL_ID[.G|.N].nequip.pt2 per node)
variable        dt        index 0.002
variable        size      index 333
variable        thermo_ps index 1.0
read_data       ../../structures/${size}/x10.data
include         ../../common/in.potential

velocity        all create 600.0 87287 mom yes rot yes dist gaussian
fix             npt all npt temp 600.0 600.0 $(100*dt) iso 0.0 0.0 $(1000*dt)
thermo          500
run             500

variable        out index bench_${tag}
if "${ana} == 1" then &
   "include ../../common/in.analysis" &
   "dump traj all custom $(round(5.0/dt)) bench_${tag}.lammpstrj.gz id type x y z c_q4[1] c_ncb" &
   "dump_modify traj sort id element Ge Sb Te C"
run             3000
