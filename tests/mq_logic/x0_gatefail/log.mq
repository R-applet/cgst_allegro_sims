LAMMPS (30 Mar 2026)
KOKKOS mode with Kokkos version 5.0.2 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
# Melt-quench of rocksalt Ge2Sb2Te5 + x% C with the Allegro model in -var model (common/model.sh). All stages NPT, isotropic, 0 bar.
#   0. minimize -> 300 K, 20 ps
#   1. heat 300 -> tmelt K (default 1500) at 10 K/ps ((tmelt-300)/10 ps); the enthalpy/volume jump gives an apparent (superheated) Tm
#   2. hold tmelt for hold_ps (100 ps; the same for every run, so every composition has the same thermal history).
#      Gate, checked 20 ps before the end: every species must have an MSD >= 100 A^2 *within the hold*, so the liquid
#      has no memory of the crystal or the replicated C pattern. If not, the run stops with an ERROR (exit 1): rerun
#      every composition with a longer hold_ps. Liquid RDF over the last 20 ps
#   3. quench tmelt -> 300 K at qrate K/ps in 100 K segments, writing snap_<T>K.data at each boundary
#   4. hold 300 K, 100 ps: relax 50 ps, then RDF and coordination averaged over the last 50 ps
#      -> amorphous_300K.data (input to recryst/)
# Each RDF window is preceded by up to one window of padding (common/in.rdf), so stages 2 and 4 run up to 20 and
# 50 ps longer than listed. The actual heating and quench start/end times (ps) are written to stages.txt.
#
# Variables (-var on the command line):
#   cell   x0 | x1 | x2p5 | x5 | x10      (structures/<size>/<cell>.data)
#   size   optional, supercell directory (default 333; 111 for tests; submit.sh passes SIZE from params)
#   seed   velocity seed (submit.sh derives it from cell and replica)
#   qrate  quench rate in K/ps (10 production; 1 sensitivity)
#   root   project root (absolute path)
#   model  compiled model file (required: it must match the node's CPU type; submit scripts pass
#          $MODEL from common/defaults.sh)
#   dt     timestep in ps (tests/RESULTS.md, 1c)
#   tscale optional, multiplies every duration and the MSD gate (testing only; 1 in production).
#          Every stage must stay a whole number of ps (e.g. tscale 0.1 works with qrate 10).
#   hold_ps optional, tmelt hold in ps before tscale (default 100; submit.sh passes HOLD_PS).
#   tmelt  optional, melt temperature in K, a multiple of 100 (default 1500; submit.sh passes TMELT). Set it from
#          the model's superheated melting point with margin (RUNBOOK.md, meltquench step 1); the same for every run.
#   gate_A2 optional, MSD gate in A^2 before tscale (default 100; tests raise it to force a gate failure).
# Thermostat/barostat damping: Tdamp = 100 dt, Pdamp = 1000 dt (LAMMPS-recommended ratios).
# Outputs in the run directory: mq.dat (every 1 ps; columns in common/in.analysis), log.mq, traj.lammpstrj.gz,
# rdf_<tmelt>K.dat, rdf_300K.dat, liquid_<tmelt>K.data, snap_<T>K.data, amorphous_300K.data, gate.txt, stages.txt,
# and rolling restart files mq.restart.a/b every 50 ps (for manual recovery only; a run normally fits one job).

units           metal
atom_style      atomic
boundary        p p p

variable        tscale    index 1
variable        size      index 333
variable        hold_ps   index 100
variable        tmelt     index 1500
variable        nq        equal round((v_tmelt-300)/100)          # 100 K quench segments
if "$(v_tmelt%100) != 0 || ${tmelt} <= 300" then "print 'ERROR: tmelt must be a multiple of 100 above 300 K'" "quit 1"
variable        gate_A2   index 100
variable        out       index mq
variable        thermo_ps index 1.0
variable        Tdamp     equal 100*${dt}
variable        Tdamp     equal 100*0.001
variable        Pdamp     equal 1000*${dt}
variable        Pdamp     equal 1000*0.001
variable        nps       equal round(1.0/${dt})                  # steps per ps
variable        nps       equal round(1.0/0.001)                  

read_data       ${root}/structures/${size}/${cell}.data
read_data       /scratch/gilbreth/rapplet/cgst_allegro_sims/structures/${size}/${cell}.data
read_data       /scratch/gilbreth/rapplet/cgst_allegro_sims/structures/111/${cell}.data
read_data       /scratch/gilbreth/rapplet/cgst_allegro_sims/structures/111/x0.data
Reading data file ...
  orthogonal box = (0 0 0) to (24.12 24.12 24.12)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  461 atoms
  read_data CPU = 0.054 seconds
include         ${root}/common/in.potential
include         /scratch/gilbreth/rapplet/cgst_allegro_sims/common/in.potential
# Shared potential, neighbor and group setup for every run in this project.
# Include after read_data / read_restart. Caller must define:
#   model   path to the compiled Allegro model (models/$MODEL_ID[.G|.N].nequip.pt2, from common/defaults.sh)
#   dt      timestep in ps (production value: common/defaults.sh; justified by tests/RESULTS.md, 1c)
# Type order is fixed by the model: 1 Ge, 2 Sb, 3 Te, 4 C (type 4 exists even when there is no C).

newton          on

pair_style      allegro
pair_coeff      * * ${model} Ge Sb Te C     # model cutoff 6.0 A
pair_coeff      * * /scratch/gilbreth/rapplet/cgst_allegro_sims/models/nozbl_paw.N.nequip.pt2 Ge Sb Te C     

neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 7.5                  # ghost shell >= 6.0 A RDF range + 1.0 A skin

group           Ge type 1
102 atoms in group Ge
group           Sb type 2
103 atoms in group Sb
group           Te type 3
256 atoms in group Te
group           C  type 4
0 atoms in group C
group           GST type 1 2 3              # the lattice-forming species (xfracGST, common/in.analysis)
461 atoms in group GST
variable        nC equal count(C)

timestep        ${dt}
timestep        0.001

# ---------- 0. minimize, equilibrate the crystal at 300 K ----------
thermo          100
thermo_style    custom step pe press vol
minimize        1.0e-6 1.0e-8 1000 10000

