# gate.txt: hold length (ps, before tscale), the smallest per-species MSD over the first hold_ps-20 ps, the gate it
# was compared with (gate_A2 x tscale), and passed (1/0)
variable        hmin_now equal ${hmin}
variable        hmin_now equal 30.6716815151219
variable        gate_now equal $(v_gate_A2*v_tscale)
variable        gate_now equal 10
variable        passed   equal $(v_hmin_now>=v_gate_now)
variable        passed   equal 1
print           "hold_ps ${hold_ps} min_species_msd_A2 $(v_hmin_now:%.1f) gate_A2 $(v_gate_now:%.6g) passed ${passed}"                 file gate.txt
hold_ps 100 min_species_msd_A2 30.7 gate_A2 10 passed 1
if "${passed} == 0" then    "print 'ERROR: MSD gate not met within the 1500 K hold; rerun every composition with a longer hold_ps (HOLD_PS)'"    "quit 1"
# last 20 ps of the hold: liquid RDF
variable        rdf_ps   index $(20*v_tscale)
variable        rdf_ps   index 2
variable        rdf_file string rdf_1500K.dat
include         ${root}/common/in.rdf
include         /scratch/gilbreth/rapplet/cgst_allegro_sims/common/in.rdf
# Time-averaged partial RDFs over the next rdf_ps of whatever integrator fix is active.
# Include at the point where averaging should start. Caller must define:
#   rdf_ps    averaging window in ps
#   rdf_file  output file
# Writes one block at the end of the window: total g(r) plus all 10 partials (Ge-Ge Ge-Sb Ge-Te Ge-C
# Sb-Sb Sb-Te Sb-C Te-Te Te-C C-C), each with its running coordination number. 300 bins to 6.0 A.
#
# fix ave/time only writes on timesteps that are multiples of Nfreq, and only when the whole sampling window
# lies after the fix was defined. The example run in md_meltquench lost its RDF for this reason. So first run
# "pad" steps up to the next multiple of Nfreq, then define the fix and run exactly one window.

variable        rdf_N   equal round(${rdf_ps}/${dt})        # window length (steps) = Nfreq
variable        rdf_N   equal round(2/${dt})        
variable        rdf_N   equal round(2/0.001)        
variable        rdf_nev equal round(0.1/${dt})              # sample every 0.1 ps
variable        rdf_nev equal round(0.1/0.001)              
variable        rdf_nrep equal ${rdf_N}/${rdf_nev}
variable        rdf_nrep equal 2000/${rdf_nev}
variable        rdf_nrep equal 2000/100
variable        rdf_pad equal ${rdf_N}*ceil(step/${rdf_N})-step
variable        rdf_pad equal 2000*ceil(step/${rdf_N})-step
variable        rdf_pad equal 2000*ceil(step/2000)-step

compute         rdf all rdf 300 * * 1 1 1 2 1 3 1 4 2 2 2 3 2 4 3 3 3 4 4 4 cutoff 6.0
run             ${rdf_pad}
run             0
