heat_end_ps 14

# ---------- 2. hold 1500 K for hold_ps; the MSD gate checks that the liquid has decorrelated ----------
dump_modify     traj every ${dump_hold}
dump_modify     traj every 5000
unfix           npt
fix             npt all npt temp 1500.0 1500.0 ${Tdamp} iso 0.0 0.0 ${Pdamp}
fix             npt all npt temp 1500.0 1500.0 0.1 iso 0.0 0.0 ${Pdamp}
fix             npt all npt temp 1500.0 1500.0 0.1 iso 0.0 0.0 1
# MSD measured from the start of the hold (the in.analysis MSDs start at step 0 and include the crystal)
compute         hGe Ge msd com yes
compute         hSb Sb msd com yes
compute         hTe Te msd com yes
# computes are only current on steps where something invokes them, so sample them through fix ave/time
# (every ps) and read the fix between runs. Every run length here is a whole number of ps.
if "${nC} > 0" then    "compute     hC C msd com yes"    "fix         hg all ave/time ${nps} 1 ${nps} c_hGe[4] c_hSb[4] c_hTe[4] c_hC[4]"    "variable    hmsdC equal f_hg[4]" else    "fix         hg all ave/time ${nps} 1 ${nps} c_hGe[4] c_hSb[4] c_hTe[4]"    "variable    hmsdC equal 1.0e9"
compute     hC C msd com yes
fix         hg all ave/time ${nps} 1 ${nps} c_hGe[4] c_hSb[4] c_hTe[4] c_hC[4]
fix         hg all ave/time 1000 1 ${nps} c_hGe[4] c_hSb[4] c_hTe[4] c_hC[4]
fix         hg all ave/time 1000 1 1000 c_hGe[4] c_hSb[4] c_hTe[4] c_hC[4]
variable    hmsdC equal f_hg[4]
# LAMMPS min() only reduces a vector, so the 4-way minimum is built from ternary(test, a, b)
variable        hm12 equal ternary(f_hg[1]<f_hg[2],f_hg[1],f_hg[2])
variable        hm3C equal ternary(f_hg[3]<v_hmsdC,f_hg[3],v_hmsdC)
variable        hmin equal ternary(v_hm12<v_hm3C,v_hm12,v_hm3C)
run             $(round((v_hold_ps-20)*v_tscale*v_nps))
run             8000
