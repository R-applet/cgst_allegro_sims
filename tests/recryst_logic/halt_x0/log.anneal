unfix           npt
# hold start and the criterion of the dumped c_ncb, read by analysis/recryst_summary.py
print           "hold_start_ps $(time) q_rc ${q_rc} q_thr ${q_thr} q_nmin ${q_nmin}" file hold_start.txt
hold_start_ps 4 q_rc 3.6 q_thr 0.5 q_nmin 4
jump            SELF hold
fix             npt all npt temp ${Ta} ${Ta} ${Tdamp} ${baro} 0.0 0.0 ${Pdamp}
fix             npt all npt temp 600 ${Ta} ${Tdamp} ${baro} 0.0 0.0 ${Pdamp}
fix             npt all npt temp 600 600 ${Tdamp} ${baro} 0.0 0.0 ${Pdamp}
fix             npt all npt temp 600 600 0.1 ${baro} 0.0 0.0 ${Pdamp}
fix             npt all npt temp 600 600 0.1 aniso 0.0 0.0 ${Pdamp}
fix             npt all npt temp 600 600 0.1 aniso 0.0 0.0 1
# deviatoric-stress check for the isotropic barostat (recryst_summary.py sdev_*; criterion in recryst/README.md)
fix             stress all print ${nthermo} "$(step) $(time) $(pxx) $(pyy) $(pzz) $(pxy) $(pxz) $(pyz)"                 ${dat_mode} stress.dat screen no title "step time_ps pxx pyy pzz pxy pxz pyz"
fix             stress all print 1000 "$(step) $(time) $(pxx) $(pyy) $(pzz) $(pxy) $(pxz) $(pyz)"                 ${dat_mode} stress.dat screen no title "step time_ps pxx pyy pzz pxy pxz pyz"
fix             stress all print 1000 "$(step) $(time) $(pxx) $(pyy) $(pzz) $(pxy) $(pxz) $(pyz)"                 file stress.dat screen no title "step time_ps pxx pyy pzz pxy pxz pyz"
dump            traj all custom $(round(10*v_nps)) traj.$(step).lammpstrj.gz id type x y z c_q4[1] c_ncb
dump            traj all custom 10000 traj.$(step).lammpstrj.gz id type x y z c_q4[1] c_ncb
dump            traj all custom 10000 traj.4000.lammpstrj.gz id type x y z c_q4[1] c_ncb
dump_modify     traj sort id element Ge Sb Te C
restart         $(round(50*v_tscale*v_nps)) anneal.*.restart
restart         5000 anneal.*.restart
fix             stop all halt ${nps} v_xfracGST > ${xstop} error continue
fix             stop all halt 1000 v_xfracGST > ${xstop} error continue
fix             stop all halt 1000 v_xfracGST > 0.0 error continue
run             ${n_end} upto
run             24000 upto
