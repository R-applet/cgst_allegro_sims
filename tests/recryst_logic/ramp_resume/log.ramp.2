package kokkos
package kokkos newton on neigh half
# Crystallization on heating (DSC-like): NPT 0 bar ramp (isotropic unless baro aniso) of an amorphous sample from
# 300 K to tmax (default 900 K), restartable at every 50 K boundary.
#   fresh start: meltquench/runs/<MODEL_ID>/<cell>_q<QRATE>_r<rep>/amorphous_300K.data, fresh velocities at 300 K
#                -> 300 K, 10 ps -> ramp 300 -> tmax at hrate K/ps ((tmax-300)/hrate ps) in 50 K segments
#   resume:      -var resume 1 -var rfile ramp.<T>K.restart continues with the segment that starts at T
#                (submit_ramp.sh passes the newest one); nothing before T is rerun
# At each boundary T (300 K after the first 10 ps, then every 50 K): snap_<T>K.data and ramp.<T>K.restart. A job killed
# inside a segment loses at most that segment (0.2 K/ps: 250 ps; ~2.3 h at 444 on 2 A100s).
# Tx = T where the Ge/Sb/Te crystalline fraction (xfracGST) has made half its rise (analysis/recryst_summary.py),
# cross-checked against the density change and the enthalpy release. tmax must stay below the model's superheated
# melting (run5_ep301: ~1090 K at 2 K/ps, so 900 K; RUNBOOK.md meltquench step 1). Ends with ramp_done.txt.
#
# Variables: cell, rep, seed, root, dt, model (as in meltquench; model is required); hrate (K/ps);
#   src (required on a fresh start) amorphous data file (submit_ramp.sh passes the glass above)
#   resume (0 = fresh start, default | 1 = continue from rfile; numeric because LAMMPS `if` cannot compare filenames),
#   rfile, tstart (the boundary T of rfile, K; submit_ramp.sh passes it)
#   tstop (optional, K, a boundary <= tmax: stop there without ramp_done.txt; tests, or to split a ramp by hand)
#   tscale (optional, tests only), q_rc/q_thr/q_nmin (optional, crystallinity criterion; see recryst/README.md),
#   baro (optional, iso default | aniso: barostat coupling; keep it the same across the jobs of one ramp)
#   tmax (optional, K, a multiple of 50 above 300; default 900; submit_ramp.sh passes TMAX)
# Outputs: ramp.dat (every 1 ps, columns in common/in.analysis; appended across resumes, MSD columns restart from 0 at
#   each resume), stress.dat (pressure tensor, every 1 ps, appended), log.ramp[.<job>], trajectory every 5 K
#   (traj.lammpstrj.gz on a fresh start, traj.<first step>.lammpstrj.gz for each resumed job), snap_<T>K.data,
#   ramp.<T>K.restart, ramp_done.txt (written last; marks a complete run)

units           metal
atom_style      atomic
boundary        p p p

variable        tscale    index 1
variable        baro      index iso
variable        tmax      index 900
variable        tstop     index ${tmax}
variable        tstop     index 900
variable        resume    index 0
variable        rfile     index none
variable        tstart    index 300
variable        nseg      equal round((v_tmax-300)/50)
if "$(v_tmax%50) != 0 || ${tmax} <= 300" then "print 'ERROR: tmax must be a multiple of 50 above 300 K'" "quit 1"
if "$(v_tstop%50) != 0 || ${tstop} <= 300 || ${tstop} > ${tmax}" then    "print 'ERROR: tstop must be a multiple of 50 in (300, tmax]'" "quit 1"
variable        out       index ramp
variable        thermo_ps index 1.0
variable        Tdamp     equal 100*${dt}
variable        Tdamp     equal 100*0.001
variable        Pdamp     equal 1000*${dt}
variable        Pdamp     equal 1000*0.001
variable        nps       equal round(1.0/${dt})
variable        nps       equal round(1.0/0.001)
variable        nstop     equal round((v_tstop-300)/50)          # last segment this job runs

if "${resume} == 1" then "jump SELF resume"
jump SELF resume
if "${tstart} == ${tstop}" then "jump SELF finish"         # killed after the last restart: nothing left to run
if "$(v_tstart%50) != 0 || ${tstart} < 300 || ${tstart} >= ${tstop}" then    "print 'ERROR: tstart must be a 50 K boundary below tstop (the T of rfile)'" "quit 1"
read_restart    ${rfile}
read_restart    ramp.600K.restart
