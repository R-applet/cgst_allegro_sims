variable        Ta loop 12
label           ramp
variable        T1 equal 250+50*${Ta}
variable        T1 equal 250+50*1
variable        T2 equal ${T1}+50
variable        T2 equal 300+50
unfix           npt
fix             npt all npt temp ${T1} ${T2} ${Tdamp} ${baro} 0.0 0.0 ${Pdamp}
fix             npt all npt temp 300 ${T2} ${Tdamp} ${baro} 0.0 0.0 ${Pdamp}
fix             npt all npt temp 300 350 ${Tdamp} ${baro} 0.0 0.0 ${Pdamp}
fix             npt all npt temp 300 350 0.1 ${baro} 0.0 0.0 ${Pdamp}
fix             npt all npt temp 300 350 0.1 iso 0.0 0.0 ${Pdamp}
fix             npt all npt temp 300 350 0.1 iso 0.0 0.0 1
run             $(round(50.0/v_hrate*v_tscale*v_nps))
run             5000
