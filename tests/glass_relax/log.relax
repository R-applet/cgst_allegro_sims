LAMMPS (30 Mar 2026)
KOKKOS mode with Kokkos version 5.0.2 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
# Relax each DFT frame with the model: NPT iso 0 bar at 300 K for 20 ps (dt 2 fs), density averaged over the last
# 10 ps. Appends "frame rho_start rho_final V_per_atom_final P_bar" to relax.txt and writes the final structure to
# relaxed_<frame>.data (positions at the end of the 20 ps, for DFT single points).
# Run with -var frames "<ids>" -var model <compiled model for this node> -var root <project root>.
variable        dt index 0.002
variable        f  index ${frames}
variable        f  index 2103 2107 2111 2115 2119 2123 2127 2131 2135 2139 2143 2147 0 63 126 189 252 315 378 441 504 567 630 693 1742 1764 1786 1808 1830 1852 1874 1896 1918 1940 1962 1984
shell           rm -f relax.txt
label           loop
clear
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
units           metal
atom_style      atomic
boundary        p p p
read_data       frame_${f}.data
read_data       frame_2103.data
Reading data file ...
  orthogonal box = (0 0 0) to (16.691391 16.691391 16.691391)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  144 atoms
  read_data CPU = 0.026 seconds
include         ${root}/common/in.potential
include         /scratch/gilbreth/rapplet/cgst_allegro_sims/common/in.potential
# Shared potential, neighbor and group setup for every run in this project.
# Include after read_data / read_restart. Caller must define:
#   model   path to the compiled Allegro model (models/run5_ep301.nequip.pt2)
#   dt      timestep in ps (production value: common/defaults.sh; justified by tests/RESULTS.md, 1c)
# Type order is fixed by the model: 1 Ge, 2 Sb, 3 Te, 4 C (type 4 exists even when there is no C).

newton          on

pair_style      allegro
pair_coeff      * * ${model} Ge Sb Te C     # model cutoff 6.0 A
pair_coeff      * * /scratch/gilbreth/rapplet/cgst_allegro_sims/tests/a100_model/run5_ep301.N.nequip.pt2 Ge Sb Te C     

neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 7.5                  # ghost shell >= 6.0 A RDF range + 1.0 A skin

group           Ge type 1
32 atoms in group Ge
group           Sb type 2
32 atoms in group Sb
group           Te type 3
80 atoms in group Te
group           C  type 4
0 atoms in group C
variable        nC equal count(C)

timestep        ${dt}
timestep        0.002
variable        rho0 equal density
variable        r0 equal ${rho0}
variable        r0 equal 5.86636164775772
velocity        all create 300.0 4242 mom yes rot yes dist gaussian
fix             npt all npt temp 300.0 300.0 0.2 iso 0.0 0.0 2.0
thermo          500
thermo_style    custom step temp press density
run             5000

