LAMMPS (30 Mar 2026)
KOKKOS mode with Kokkos version 5.0.2 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
# Crystallinity calibration: sample a reference state at temperature T for calibrate.py.
#   src -> minimize (crystal only) -> NPT iso 0 bar at T: 10 ps equilibration, then 10 ps dumped every 0.5 ps
# Reference states (calib/submit.sh): rocksalt x0..x5 crystals (structures/333) and the 10 K/ps amorphous samples,
# each at 300, 500, 550, 600, 650 and 700 K (including the planned anneal temperatures). Short enough that the
# amorphous sample does not crystallize.
# Variables: src (data file), T (K), tag (output prefix), seed, root, dt, minimize (0|1), model (required; as in
#   meltquench)
# Output: <tag>.lammpstrj.gz (id type x y z), <tag>.dat (thermo; columns in common/in.analysis)

units           metal
atom_style      atomic
boundary        p p p

variable        minimize  index 0
variable        out       index ${tag}
variable        out       index amor_x5_300K
variable        thermo_ps index 1.0
variable        nps       equal round(1.0/${dt})
variable        nps       equal round(1.0/0.002)

read_data       ${src}
read_data       /scratch/gilbreth/rapplet/cgst_allegro_sims/meltquench/runs/x5_q10_r1/amorphous_300K.data
Reading data file ...
  orthogonal box = (-0.085614359 -0.085614359 -0.085614359) to (72.445614 72.445614 72.445614)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  13122 atoms
  reading velocities ...
  13122 velocities
  read_data CPU = 0.488 seconds
include         ${root}/common/in.potential
include         /scratch/gilbreth/rapplet/cgst_allegro_sims/common/in.potential
# Shared potential, neighbor and group setup for every run in this project.
# Include after read_data / read_restart. Caller must define:
#   model   path to the compiled Allegro model (models/run5_ep301.nequip.pt2)
#   dt      timestep in ps (production value: common/defaults.sh; justified by tests/RESULTS.md, 1c)
# Type order is fixed by the model: 1 Ge, 2 Sb, 3 Te, 4 C (type 4 exists even when there is no C).

newton          on

pair_style      allegro
pair_coeff      * * ${model} Ge Sb Te C     # model cutoff 6.0 A
pair_coeff      * * /scratch/gilbreth/rapplet/cgst_allegro_sims/models/run5_ep301.nequip.pt2 Ge Sb Te C     

neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 7.5                  # ghost shell >= 6.0 A RDF range + 1.0 A skin

group           Ge type 1
2754 atoms in group Ge
group           Sb type 2
2781 atoms in group Sb
group           Te type 3
6912 atoms in group Te
group           C  type 4
675 atoms in group C
group           GST type 1 2 3              # the lattice-forming species (xfracGST, common/in.analysis)
12447 atoms in group GST
variable        nC equal count(C)

timestep        ${dt}
timestep        0.002
if "${minimize} == 1" then "minimize 1.0e-6 1.0e-8 1000 10000" "reset_timestep 0"
include         ${root}/common/in.analysis
include         /scratch/gilbreth/rapplet/cgst_allegro_sims/common/in.analysis
# Shared on-the-fly analysis: thermodynamics, per-species MSD and crystallinity, written every thermo_ps.
# Include after common/in.potential. Caller must define:
#   out        prefix for output files (writes ${out}.dat)
#   thermo_ps  output interval in ps (1.0 in production)
# Optional overrides (-var or set before the include), defaults below:
#   q_rc q_thr q_nmin   crystallinity criterion; calibrated in recryst/calib (see recryst/README.md)
#   dat_mode            file (default: start ${out}.dat afresh) | append (continue it, e.g. after a restart)
#
# Columns of ${out}.dat:
#   step time_ps T_K P_bar V_A3_per_atom rho_gcc PE_eV_per_atom H_eV_per_atom
#   msdGe msdSb msdTe msdC (A^2, centre-of-mass corrected, reference = positions when this file is included)
#   xfrac (fraction of all atoms classed crystalline), xfracGST (the same over Ge, Sb and Te only)
# xfracGST is the measure for crystallization (recryst/): even on rocksalt sites C scores crystalline far less often
# than Ge/Sb/Te (minimized x10 rocksalt: C 0.55, Ge/Sb/Te 0.98), and a growing crystal is expected to reject much of
# the C, so counting C would lower the crystalline ceiling with C content and bias any fixed threshold.
# MSD references reset when the include runs again (e.g. in a job restarted from a restart file).
# Coordination numbers are not computed here: a single coord/atom cutoff cannot serve both C-X (~2 A) and
# Ge/Sb-Te (~3 A) bonds. They come afterwards, with fixed per-pair bond cutoffs: averages from the running-
# coordination columns of common/in.rdf (analysis/mq_summary.py), per-atom values from the trajectory
# (analysis/mq_structure.py). coord/atom is used here only for the Q4 crystal-like bond count.

variable        nthermo equal round(${thermo_ps}/${dt})
variable        nthermo equal round(1.0/${dt})
variable        nthermo equal round(1.0/0.002)
variable        dat_mode index file

# ---------- thermodynamics ----------
compute         epot all pe
compute         ekin all ke
variable        Vat  equal vol/atoms
variable        PEat equal c_epot/atoms
# enthalpy per atom: E_pot + E_kin + P*V, with bar*A^3 -> eV (1 eV = 1602176.6 bar*A^3)
variable        Hat  equal (c_epot+c_ekin+press*vol/1602176.6)/atoms

# ---------- per-species MSD (msd on an empty group divides by zero, so C is guarded) ----------
compute         msdGe Ge msd com yes
compute         msdSb Sb msd com yes
compute         msdTe Te msd com yes
if "${nC} > 0" then    "compute     msdC C msd com yes"    "variable    msdC equal c_msdC[4]" else    "variable    msdC equal 0.0"
compute     msdC C msd com yes
variable    msdC equal c_msdC[4]

# ---------- crystallinity: Q4 bond-order connections (ten Wolde-style) ----------
# q4 uses all neighbours within q_rc, which sits between the rocksalt first shell (~2.9-3.4 A, Peierls-split)
# and second shell (~4.3 A). A bond i-j is crystal-like if the normalized q4(i).q4(j) > q_thr; an atom is
# crystalline with >= q_nmin crystal-like bonds. coord/atom orientorder reuses the q4 compute's cutoff.
variable        q_rc   index 3.6
variable        q_thr  index 0.5
variable        q_nmin index 4
compute         q4 all orientorder/atom degrees 1 4 nnn NULL cutoff ${q_rc} components 4
compute         q4 all orientorder/atom degrees 1 4 nnn NULL cutoff 3.6 components 4
compute         ncb all coord/atom orientorder q4 ${q_thr}
compute         ncb all coord/atom orientorder q4 0.5
variable        xtal atom c_ncb>=${q_nmin}
variable        xtal atom c_ncb>=4
compute         nxtal all reduce sum v_xtal
variable        xfrac equal c_nxtal/atoms
compute         nxtalGST GST reduce sum v_xtal
variable        xfracGST equal c_nxtalGST/count(GST)

# ---------- output ----------
thermo_style    custom step time temp press vol v_Vat density v_PEat v_Hat                 c_msdGe[4] c_msdSb[4] c_msdTe[4] v_msdC v_xfrac v_xfracGST
thermo_modify   flush yes
thermo          ${nthermo}
thermo          500

fix             log all print ${nthermo}                 "$(step) $(time) $(temp) $(press) $(v_Vat) $(density) $(v_PEat) $(v_Hat) $(c_msdGe[4]) $(c_msdSb[4]) $(c_msdTe[4]) $(v_msdC) $(v_xfrac) $(v_xfracGST)"                 ${dat_mode} ${out}.dat screen no                 title "step time_ps T_K P_bar V_A3_per_atom rho_gcc PE_eV_per_atom H_eV_per_atom msdGe msdSb msdTe msdC xfrac xfracGST"
fix             log all print 500                 "$(step) $(time) $(temp) $(press) $(v_Vat) $(density) $(v_PEat) $(v_Hat) $(c_msdGe[4]) $(c_msdSb[4]) $(c_msdTe[4]) $(v_msdC) $(v_xfrac) $(v_xfracGST)"                 ${dat_mode} ${out}.dat screen no                 title "step time_ps T_K P_bar V_A3_per_atom rho_gcc PE_eV_per_atom H_eV_per_atom msdGe msdSb msdTe msdC xfrac xfracGST"
fix             log all print 500                 "$(step) $(time) $(temp) $(press) $(v_Vat) $(density) $(v_PEat) $(v_Hat) $(c_msdGe[4]) $(c_msdSb[4]) $(c_msdTe[4]) $(v_msdC) $(v_xfrac) $(v_xfracGST)"                 file ${out}.dat screen no                 title "step time_ps T_K P_bar V_A3_per_atom rho_gcc PE_eV_per_atom H_eV_per_atom msdGe msdSb msdTe msdC xfrac xfracGST"
fix             log all print 500                 "$(step) $(time) $(temp) $(press) $(v_Vat) $(density) $(v_PEat) $(v_Hat) $(c_msdGe[4]) $(c_msdSb[4]) $(c_msdTe[4]) $(v_msdC) $(v_xfrac) $(v_xfracGST)"                 file amor_x5_300K.dat screen no                 title "step time_ps T_K P_bar V_A3_per_atom rho_gcc PE_eV_per_atom H_eV_per_atom msdGe msdSb msdTe msdC xfrac xfracGST"

velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
velocity        all create 300 ${seed} mom yes rot yes dist gaussian
velocity        all create 300 1720387 mom yes rot yes dist gaussian
fix             npt all npt temp ${T} ${T} $(100*dt) iso 0.0 0.0 $(1000*dt)
fix             npt all npt temp 300 ${T} $(100*dt) iso 0.0 0.0 $(1000*dt)
fix             npt all npt temp 300 300 $(100*dt) iso 0.0 0.0 $(1000*dt)
fix             npt all npt temp 300 300 0.2000000000000000111 iso 0.0 0.0 $(1000*dt)
fix             npt all npt temp 300 300 0.2000000000000000111 iso 0.0 0.0 2
run             $(10*v_nps)
run             5000

