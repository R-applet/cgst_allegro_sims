fix             log all print 500                 "$(step) $(time) $(temp) $(press) $(v_Vat) $(density) $(v_PEat) $(v_Hat) $(c_msdGe[4]) $(c_msdSb[4]) $(c_msdTe[4]) $(v_msdC) $(v_xfrac) $(v_xfracGST)"                 file amor_x2p5_600K.dat screen no                 title "step time_ps T_K P_bar V_A3_per_atom rho_gcc PE_eV_per_atom H_eV_per_atom msdGe msdSb msdTe msdC xfrac xfracGST"

velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
velocity        all create 600 ${seed} mom yes rot yes dist gaussian
velocity        all create 600 1600360 mom yes rot yes dist gaussian
fix             npt all npt temp ${T} ${T} $(100*dt) iso 0.0 0.0 $(1000*dt)
fix             npt all npt temp 600 ${T} $(100*dt) iso 0.0 0.0 $(1000*dt)
