package kokkos
package kokkos newton on neigh half
# Crystallinity calibration: sample a reference state at temperature T for calibrate.py.
#   src -> minimize (crystal only) -> NPT iso 0 bar at T: 10 ps equilibration, then 10 ps dumped every 0.5 ps
# Reference states (calib/submit.sh): rocksalt x0..x5 crystals (structures/<SIZE>, as the glasses) and the 10 K/ps amorphous samples,
# each at 300, 500, 550, 600, 650 and 700 K (including the planned anneal temperatures). Short enough that the
# amorphous sample does not crystallize.
# Variables: src (data file), T (K), tag (output prefix), seed, root, dt, minimize (0|1), model (required; as in
#   meltquench)
# Output: <tag>.lammpstrj.gz (id type x y z), <tag>.dat (thermo; columns in common/in.analysis)

units           metal
atom_style      atomic
boundary        p p p

variable        minimize  index 0
variable        out       index ${tag}
variable        out       index crys_x1_650K
variable        thermo_ps index 1.0
variable        nps       equal round(1.0/${dt})
variable        nps       equal round(1.0/0.002)

read_data       ${src}
read_data       /scratch/gilbreth/rapplet/cgst_allegro_sims/structures/444/x1.data
Reading data file ...
  orthogonal box = (0 0 0) to (96.48 96.48 96.48)
  1 by 1 by 2 MPI processor grid
  reading atoms ...
  29824 atoms
  read_data CPU = 0.313 seconds
include         ${root}/common/in.potential
include         /scratch/gilbreth/rapplet/cgst_allegro_sims/common/in.potential
# Shared potential, neighbor and group setup for every run in this project.
# Include after read_data / read_restart. Caller must define:
#   model   path to the compiled Allegro model (models/$MODEL_ID[.G|.N].nequip.pt2, from common/defaults.sh)
#   dt      timestep in ps (production value: common/defaults.sh; justified by tests/RESULTS.md, 1c)
# Type order is fixed by the model: 1 Ge, 2 Sb, 3 Te, 4 C (type 4 exists even when there is no C).

newton          on

pair_style      allegro
pair_coeff      * * ${model} Ge Sb Te C     # model cutoff 6.0 A
pair_coeff      * * /scratch/gilbreth/rapplet/cgst_allegro_sims/models/nozbl_paw.N.nequip.pt2 Ge Sb Te C     

neighbor        1.0 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 7.5                  # ghost shell >= 6.0 A RDF range + 1.0 A skin

group           Ge type 1
6528 atoms in group Ge
group           Sb type 2
6592 atoms in group Sb
group           Te type 3
16384 atoms in group Te
group           C  type 4
320 atoms in group C
group           GST type 1 2 3              # the lattice-forming species (xfracGST, common/in.analysis)
29504 atoms in group GST
variable        nC equal count(C)

timestep        ${dt}
timestep        0.002
if "${minimize} == 1" then "minimize 1.0e-6 1.0e-8 1000 10000" "reset_timestep 0"
minimize 1.0e-6 1.0e-8 1000 10000

