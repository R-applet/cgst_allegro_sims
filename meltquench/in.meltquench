# Melt-quench of rocksalt Ge2Sb2Te5 + x% C with the Allegro model in -var model (common/model.sh). All stages NPT, isotropic, 0 bar.
#   0. minimize -> 300 K, 20 ps
#   1. heat 300 -> tmelt K (default 1500) at 10 K/ps ((tmelt-300)/10 ps); the enthalpy/volume jump gives an apparent (superheated) Tm
#   2. hold tmelt for hold_ps (100 ps; the same for every run, so every composition has the same thermal history).
#      Gate, checked 20 ps before the end: every species must have an MSD >= 100 A^2 *within the hold*, so the liquid
#      has no memory of the crystal or the replicated C pattern. If not, the run stops with an ERROR (exit 1): rerun
#      every composition with a longer hold_ps. Liquid RDF over the last 20 ps
#   3. quench tmelt -> 300 K at qrate K/ps in 100 K segments, writing snap_<T>K.data at each boundary
#   4. hold 300 K, 100 ps: relax 50 ps, then RDF and coordination averaged over the last 50 ps
#      -> amorphous_300K.data (input to recryst/)
# Each RDF window is preceded by up to one window of padding (common/in.rdf), so stages 2 and 4 run up to 20 and
# 50 ps longer than listed. The actual heating and quench start/end times (ps) are written to stages.txt.
#
# Variables (-var on the command line):
#   cell   x0 | x1 | x2p5 | x5 | x10      (structures/<size>/<cell>.data)
#   size   optional, supercell directory (default 333; 111 for tests; submit.sh passes SIZE from params)
#   seed   velocity seed (submit.sh derives it from cell and replica)
#   qrate  quench rate in K/ps (10 production; 1 sensitivity)
#   root   project root (absolute path)
#   model  compiled model file (required: it must match the node's CPU type; submit scripts pass
#          $MODEL from common/defaults.sh)
#   dt     timestep in ps (tests/RESULTS.md, 1c)
#   tscale optional, multiplies every duration and the MSD gate (testing only; 1 in production).
#          Every stage must stay a whole number of ps (e.g. tscale 0.1 works with qrate 10).
#   hold_ps optional, tmelt hold in ps before tscale (default 100; submit.sh passes HOLD_PS).
#   tmelt  optional, melt temperature in K, a multiple of 100 (default 1500; submit.sh passes TMELT). Set it from
#          the model's superheated melting point with margin (RUNBOOK.md, meltquench step 1); the same for every run.
#   gate_A2 optional, MSD gate in A^2 before tscale (default 100; tests raise it to force a gate failure).
# Thermostat/barostat damping: Tdamp = 100 dt, Pdamp = 1000 dt (LAMMPS-recommended ratios).
# Outputs in the run directory: mq.dat (every 1 ps; columns in common/in.analysis), log.mq, traj.lammpstrj.gz,
# rdf_<tmelt>K.dat, rdf_300K.dat, liquid_<tmelt>K.data, snap_<T>K.data, amorphous_300K.data, gate.txt, stages.txt,
# and rolling restart files mq.restart.a/b every 50 ps (for manual recovery only; a run normally fits one job).

units           metal
atom_style      atomic
boundary        p p p

variable        tscale    index 1
variable        size      index 333
variable        hold_ps   index 100
variable        tmelt     index 1500
variable        nq        equal round((v_tmelt-300)/100)          # 100 K quench segments
if "$(v_tmelt%100) != 0 || ${tmelt} <= 300" then "print 'ERROR: tmelt must be a multiple of 100 above 300 K'" "quit 1"
variable        gate_A2   index 100
variable        out       index mq
variable        thermo_ps index 1.0
variable        Tdamp     equal 100*${dt}
variable        Pdamp     equal 1000*${dt}
variable        nps       equal round(1.0/${dt})                  # steps per ps

read_data       ${root}/structures/${size}/${cell}.data
include         ${root}/common/in.potential

# ---------- 0. minimize, equilibrate the crystal at 300 K ----------
thermo          100
thermo_style    custom step pe press vol
minimize        1.0e-6 1.0e-8 1000 10000
reset_timestep  0

include         ${root}/common/in.analysis
restart         $(round(50*v_tscale*v_nps)) mq.restart.a mq.restart.b

# trajectory: every 10 K on the ramps (1 ps on heating; 10/qrate ps on the quench), every 5 ps on holds
variable        dump_hold equal round(5.0*${nps})
dump            traj all custom ${dump_hold} traj.lammpstrj.gz id type x y z c_q4[1] c_ncb
dump_modify     traj sort id element Ge Sb Te C

velocity        all create 300.0 ${seed} mom yes rot yes dist gaussian
fix             npt all npt temp 300.0 300.0 ${Tdamp} iso 0.0 0.0 ${Pdamp}
run             $(round(20*v_tscale*v_nps))

# ---------- 1. heat 300 -> tmelt at 10 K/ps ----------
print           "heat_start_ps $(step*dt)" file stages.txt
dump_modify     traj every ${nps}
unfix           npt
fix             npt all npt temp 300.0 ${tmelt} ${Tdamp} iso 0.0 0.0 ${Pdamp}
run             $(round((v_tmelt-300)/10*v_tscale*v_nps))
print           "heat_end_ps $(step*dt)" append stages.txt

# ---------- 2. hold tmelt for hold_ps; the MSD gate checks that the liquid has decorrelated ----------
dump_modify     traj every ${dump_hold}
unfix           npt
fix             npt all npt temp ${tmelt} ${tmelt} ${Tdamp} iso 0.0 0.0 ${Pdamp}
# MSD measured from the start of the hold (the in.analysis MSDs start at step 0 and include the crystal)
compute         hGe Ge msd com yes
compute         hSb Sb msd com yes
compute         hTe Te msd com yes
# computes are only current on steps where something invokes them, so sample them through fix ave/time
# (every ps) and read the fix between runs. Every run length here is a whole number of ps.
if "${nC} > 0" then &
   "compute     hC C msd com yes" &
   "fix         hg all ave/time ${nps} 1 ${nps} c_hGe[4] c_hSb[4] c_hTe[4] c_hC[4]" &
   "variable    hmsdC equal f_hg[4]" &
else &
   "fix         hg all ave/time ${nps} 1 ${nps} c_hGe[4] c_hSb[4] c_hTe[4]" &
   "variable    hmsdC equal 1.0e9"
# LAMMPS min() only reduces a vector, so the 4-way minimum is built from ternary(test, a, b)
variable        hm12 equal ternary(f_hg[1]<f_hg[2],f_hg[1],f_hg[2])
variable        hm3C equal ternary(f_hg[3]<v_hmsdC,f_hg[3],v_hmsdC)
variable        hmin equal ternary(v_hm12<v_hm3C,v_hm12,v_hm3C)
run             $(round((v_hold_ps-20)*v_tscale*v_nps))
# gate.txt: hold length (ps, before tscale), the smallest per-species MSD over the first hold_ps-20 ps, the gate it
# was compared with (gate_A2 x tscale), and passed (1/0)
variable        hmin_now equal ${hmin}
variable        gate_now equal $(v_gate_A2*v_tscale)
variable        passed   equal $(v_hmin_now>=v_gate_now)
print           "hold_ps ${hold_ps} min_species_msd_A2 $(v_hmin_now:%.1f) gate_A2 $(v_gate_now:%.6g) passed ${passed}" &
                file gate.txt
if "${passed} == 0" then &
   "print 'ERROR: MSD gate not met within the ${tmelt} K hold; rerun every composition with a longer hold_ps (HOLD_PS)'" &
   "quit 1"
# last 20 ps of the hold: liquid RDF
variable        rdf_ps   index $(20*v_tscale)
variable        rdf_file string rdf_${tmelt}K.dat
include         ${root}/common/in.rdf
write_data      liquid_${tmelt}K.data
unfix           hg
uncompute       hGe
uncompute       hSb
uncompute       hTe
if "${nC} > 0" then "uncompute hC"
print           "quench_start_ps $(step*dt)" append stages.txt

# ---------- 3. quench tmelt -> 300 K at qrate K/ps, 100 K per segment ----------
dump_modify     traj every $(round(10.0/v_qrate*v_nps))
variable        Ta loop ${nq}
label           quench
variable        T1 equal ${tmelt}+100-100*${Ta}
variable        T2 equal ${T1}-100
unfix           npt
fix             npt all npt temp ${T1} ${T2} ${Tdamp} iso 0.0 0.0 ${Pdamp}
run             $(round(100.0/v_qrate*v_tscale*v_nps))
write_data      snap_${T2}K.data
next            Ta
jump            SELF quench
print           "quench_end_ps $(step*dt)" append stages.txt

# ---------- 4. hold 300 K: relax 50 ps, then average the RDF over 50 ps ----------
dump_modify     traj every ${dump_hold}
unfix           npt
fix             npt all npt temp 300.0 300.0 ${Tdamp} iso 0.0 0.0 ${Pdamp}
run             $(round(50*v_tscale*v_nps))
variable        rdf_ps   delete
variable        rdf_ps   index $(50*v_tscale)
variable        rdf_file string rdf_300K.dat
include         ${root}/common/in.rdf
write_data      amorphous_300K.data
